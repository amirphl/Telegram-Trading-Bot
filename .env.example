# Required Telegram application credentials from https://my.telegram.org
API_ID=
API_HASH=
SESSION_NAME=tg_session

# Select exactly one channel by numeric marked ID or public title/username.
CHANNEL_ID=
CHANNEL_TITLE=

# Optional proxy. Leave every value empty to connect directly.
PROXY_TYPE=
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Storage and Telegram recovery behavior.
DB_PATH=./tg_channel.db
MEDIA_DIR=./output/media
BACKFILL=3
HEARTBEAT_SECS=180
MAX_BACKOFF_SECS=300
SQL_BUSY_RETRIES=10
SQL_BUSY_SLEEP=0.2

# Media safety limits.
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_TOTAL_BYTES=20971520
MEDIA_MAX_PIXELS=25000000
MEDIA_MAX_IMAGES=4
MEDIA_MAX_DISK_BYTES=1073741824
MEDIA_RETENTION_DAYS=0

# AI extraction is disabled safely until explicitly enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECS=30
OPENAI_BASE_URL=
SIGNAL_EXTRACTION_ENABLED=false
SIGNAL_APPROVAL_MODE=manual
SIGNAL_TOKEN_ALLOWLIST=
SIGNAL_MAX_AGE_SECS=300
SIGNAL_MIN_CONFIDENCE=0.75
SIGNAL_MAX_OPEN_POSITIONS=3
SIGNAL_MAX_TOTAL_NOTIONAL=100
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RETRY_BASE_SECS=15
EXTRACTION_WORKER_INTERVAL_SECS=5
HISTORICAL_SIGNAL_POLICY=store_only

# Exchange credentials are optional while execution is disabled.
LBANK_API_KEY=
LBANK_SECRET=
LBANK_PASSWORD=
ENABLE_AUTO_EXECUTION=false
TRADING_MODE=sandbox
EXECUTION_MARKET_TYPE=spot
MARGIN_MODE=isolated
ORDER_QUOTE=USDT
ORDER_NOTIONAL=10
MAX_PRICE_DEVIATION_PCT=0.02
REQUIRE_PROTECTIVE_ORDERS=true
TICKER_MAX_AGE_SECS=15
BALANCE_BUFFER_PCT=0.01
MAX_LEVERAGE=5
LIVE_TRADING_CONFIRMATION=

# Bounded worker, retry, and timeout settings.
BLOCKING_WORKERS=4
BLOCKING_QUEUE_LIMIT=16
BLOCKING_SUBMIT_TIMEOUT_SECS=5
BLOCKING_OPERATION_TIMEOUT_SECS=60
EXCHANGE_TIMEOUT_SECS=30
BACKFILL_MAX_ATTEMPTS=3
BACKFILL_PAGE_SIZE=100
BACKFILL_RETRY_BASE_SECS=1
BACKFILL_FAILURE_POLICY=continue_live
HEARTBEAT_FAILURE_THRESHOLD=3
AUTH_RETRY_MAX_ATTEMPTS=3
